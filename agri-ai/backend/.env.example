# AgriAI Backend Environment
# Copy this file to .env and fill in real values. NEVER commit a real .env.

# App
DEBUG=true
# DEMO_MODE=true uses a clearly-labeled mock model service with the SAME
# interface as the real one. false attempts to load trained models from
# backend/models/*.
DEMO_MODE=true

# Database — SQLite for dev (default), Postgres for production
# DATABASE_URL=sqlite:///./agriai.db
DATABASE_URL=sqlite:///./agriai.db
# DATABASE_URL=postgresql://agriai:password@localhost:5432/agriai

# JWT Auth — CHANGE THIS IN PRODUCTION
SECRET_KEY=replace-this-with-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# External APIs (proxied through backend only — NEVER in frontend)
OPENWEATHER_API_KEY=
MARKET_API_KEY=

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
