{
  "expo": {
    "name": "AgriAI",
    "slug": "agriai-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#1e7a3a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.agriai.mobile",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "AgriAI uses your location to identify your farm location and provide location-based soil, map, and weather information."
      }
    },
    "android": {
      "package": "com.agriai.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#1e7a3a",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "AgriAI uses your location to identify your farm location and provide location-based soil, map, and weather information."
        }
      ]
    ]
  }
}
